{
	"schemaVersion": 1,
	"id": "espresso_flavoured",
	"version": "${version}",
	"name": "Espresso Flavoured",
	"description": "A shot of espresso for your survival world: a safe home radius, builds creepers can't wreck, longer days, shorter but sharper nights, graves-friendly deaths that keep your hotbar, Overworld shulker boxes, roomier bundles, a block merchant, and coffee to keep you going.",
	"authors": [
		"Gabby"
	],
	"license": [
		"MIT",
		"CC-BY-NC-SA-4.0"
	],
	"icon": "assets/espresso_flavoured/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gabbymaybelle.espresso.Espresso"
		],
		"client": [
			"com.gabbymaybelle.espresso.client.EspressoClient"
		],
		"modmenu": [
			"com.gabbymaybelle.espresso.client.ModMenuIntegration"
		],
		"jade": [
			"com.gabbymaybelle.espresso.compat.EspressoJadePlugin"
		],
		"jei_mod_plugin": [
			"com.gabbymaybelle.espresso.compat.EspressoJeiPlugin"
		]
	},
	"mixins": [
		"espresso_flavoured.mixins.json",
		"espresso_flavoured.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
