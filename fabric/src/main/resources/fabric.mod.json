{
	"schemaVersion": 1,
	"id": "espresso_flavoured",
	"version": "${version}",
	"name": "Espresso Flavoured Core",
	"description": "A little café for your survival world: coffee you grow and brew, mugs you shape and dye, baristas, Bean Coins and charms, with longer days and a home bed worth walking back to.",
	"authors": [
		"Gabby"
	],
	"contact": {
		"homepage": "https://github.com/gabmaybelle/espresso-flavoured",
		"sources": "https://github.com/gabmaybelle/espresso-flavoured",
		"issues": "https://github.com/gabmaybelle/espresso-flavoured/issues"
	},
	"license": [
		"MIT",
		"CC-BY-NC-SA-4.0"
	],
	"icon": "assets/espresso_flavoured/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gabbymaybelle.espresso.fabric.EspressoFabric"
		],
		"client": [
			"com.gabbymaybelle.espresso.fabric.EspressoFabricClient"
		],
		"modmenu": [
			"com.gabbymaybelle.espresso.client.ModMenuIntegration"
		],
		"jade": [
			"com.gabbymaybelle.espresso.compat.EspressoJadePlugin"
		],
		"jei_mod_plugin": [
			"com.gabbymaybelle.espresso.compat.EspressoJeiPlugin"
		]
	},
	"mixins": [
		"espresso_flavoured.mixins.json",
		"espresso_flavoured.optional.mixins.json",
		"espresso_flavoured.client.mixins.json"
	],
	"depends": {
		"spawn_gazebo": ">=1.2.0",
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"custom": {
		"spawn_gazebo": {
			"starter_kit": "espresso_flavoured:chests/spawn_kit"
		}
	},
	"suggests": {
		"trinkets_updated": "*",
		"jei": "*",
		"jade": "*",
		"modmenu": "*"
	}
}
